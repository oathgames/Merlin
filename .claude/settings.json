{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "TodoWrite",
      "Skill",
      "mcp__merlin__*",
      "Bash(curl -sI *)",
      "Bash(curl *github.com*)",
      "Bash(curl *merlingotme.com*)",
      "Bash(ls *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "mcp__scheduled-tasks__list_scheduled_tasks",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__update_scheduled_task"
    ],
    "deny": [
      "Bash(*graph.facebook.com*)",
      "Bash(*business.facebook.com*)",
      "Bash(*business-api.tiktok.com*)",
      "Bash(*open-api.tiktok.com*)",
      "Bash(*open.tiktokapis.com*)",
      "Bash(*googleads.googleapis.com*)",
      "Bash(*advertising-api.amazon*)",
      "Bash(*sellingpartnerapi*)",
      "Bash(*api.klaviyo.com*)",
      "Bash(*a.klaviyo.com*)",
      "Bash(*ads-api.reddit.com*)",
      "Bash(*openapi.etsy.com*)",
      "Bash(*graph.threads.net*)",
      "Bash(*curl*|*sh*)",
      "Bash(*curl*|*bash*)",
      "Bash(*wget*-O-*|*sh*)",
      "Bash(*nc -*)",
      "Bash(*ncat *)",
      "Bash(*socat *)",
      "Bash(*openssl s_client*)",
      "Bash(*cp*.merlin-*)",
      "Bash(*cp*merlin-config*)",
      "Bash(*copy*.merlin-*)",
      "Bash(*Copy-Item*.merlin-*)",
      "Bash(*.credentials*)",
      "Bash(*/.ssh/*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*rm*.merlin-ratelimit*)",
      "Bash(*rm*.merlin-vault*)",
      "Bash(*rm*.merlin-audit*)",
      "Bash(*rm*.merlin-entitlement-cache*)",
      "Bash(*rm*merlin-config*)",
      "Bash(*del*.merlin-*)",
      "Bash(*Remove-Item*.merlin-*)",
      "WebFetch(*graph.facebook.com*)",
      "WebFetch(*business-api.tiktok.com*)",
      "WebFetch(*googleads.googleapis.com*)",
      "WebFetch(*api.klaviyo.com*)",
      "WebFetch(*.myshopify.com/admin/api*)",
      "WebFetch(*ads-api.reddit.com*)",
      "WebFetch(*openapi.etsy.com*)",
      "WebFetch(*graph.threads.net*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-api-bypass.js"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-api-bypass.js"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-api-bypass.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "prompt",
        "prompt": "Check if any new content was generated this session (new folders in results/ created today). If yes, append a one-line entry to memory.md Run Log: date | brand | product | type | result. Keep it brief. If no new content, do nothing."
      }
    ]
  }
}
